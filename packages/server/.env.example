# ==========================================
# AgentScope Server Environment Configuration
# ==========================================
# The server does not load this file automatically. Either export the
# variables, or pass the file to uvicorn:
#   uvicorn main:app --port 8765 --env-file .env
# Host and port are uvicorn arguments (--host/--port), not variables here.

# ------------------------------------------
# Database Storage Backend
# ------------------------------------------
# Option 1: SQLite (Default zero-configuration local file)
DATABASE_URL=sqlite+aiosqlite:///./agentscope.db

# Option 2: PostgreSQL (Enterprise / Production)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Standard scheme (postgresql://...) is also automatically normalized to asyncpg.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentscope

# PostgreSQL Connection Pooling (Optional)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ------------------------------------------
# Retention & Pruning (Optional)
# ------------------------------------------
# AGENTSCOPE_RETENTION_DAYS=30
# AGENTSCOPE_MAX_SESSIONS=1000
# AGENTSCOPE_PRUNE_INTERVAL_SECONDS=3600

# ------------------------------------------
# Security & Networking (Optional)
# ------------------------------------------
# CORS_ALLOW_ORIGINS=http://localhost:3000

# API-key authentication (disabled when unset). When set, /api/* and /ws
# require the key; /health stays public. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The server refuses to start with keys under 16 characters or with
# placeholders like "change-me". AGENTSCOPE_API_KEY is one key (never split).
# AGENTSCOPE_API_KEY=
# Comma-separated list, e.g. while rotating from an old key to a new one:
# AGENTSCOPE_API_KEYS=<old-key>,<new-key>

# ------------------------------------------
# Mem0 Integration (Optional)
# ------------------------------------------
# MEM0_API_KEY=your_mem0_api_key
